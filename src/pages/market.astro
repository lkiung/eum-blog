---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog')).map(post => {
    const d = post.data.pubDate;
    const year = d.getFullYear();
    const month = String(d.getMonth() + 1).padStart(2, '0');
    const day = String(d.getDate()).padStart(2, '0');
    return {
        id: post.id,
        title: post.data.title,
        description: post.data.description,
        pubDate: `${year}-${month}-${day}`,
        heroImage: post.data.heroImage?.src || ''
    };
});

const postsJson = JSON.stringify(posts);
const postsBase64 = Buffer.from(postsJson).toString('base64');
---

<!doctype html>
<html lang="ko">
	<head>
		<BaseHead title={`Market Insights | ${SITE_TITLE}`} description={SITE_DESCRIPTION} />
		<script src="https://unpkg.com/lightweight-charts@3.8.0/dist/lightweight-charts.standalone.production.js"></script>
		<style>
			main {
				width: 1200px;
				max-width: calc(100% - 2em);
				margin: auto;
				padding: 2em 0;
			}
			.market-header {
				margin-bottom: 2rem;
				text-align: center;
			}
			.market-header h1 {
				font-size: 2.5rem;
				margin-bottom: 0.5rem;
				background: linear-gradient(to right, #fff, var(--accent));
				-webkit-background-clip: text;
				-webkit-text-fill-color: transparent;
			}
			.chart-container-wrapper {
				position: relative;
				background: rgba(15, 18, 25, 0.5);
				border: 1px solid rgba(255, 255, 255, 0.1);
				border-radius: 24px;
				padding: 20px;
				backdrop-filter: blur(10px);
				margin-bottom: 2rem;
				box-shadow: 0 20px 40px rgba(0,0,0,0.4);
			}
			#chart-container {
				height: 600px;
				width: 100%;
			}
			.news-preview-card {
				position: absolute;
				display: none;
				z-index: 1000;
				width: 320px;
				background: rgba(15, 18, 25, 0.95);
				border: 1px solid var(--accent);
				border-radius: 16px;
				padding: 20px;
				box-shadow: 0 15px 40px rgba(0,0,0,0.6);
				pointer-events: none;
				backdrop-filter: blur(15px);
				transition: opacity 0.1s ease;
			}
			.news-preview-card h4 {
				margin: 0 0 10px 0;
				color: var(--accent);
				font-size: 1.1rem;
				font-weight: 700;
				line-height: 1.3;
			}
			.news-preview-card p {
				margin: 0;
				font-size: 0.95rem;
				color: #e0e0e0;
				line-height: 1.5;
			}
			.spotlight-section {
				display: none;
				margin-top: 2rem;
				padding: 2rem;
				background: rgba(255, 255, 255, 0.03);
				border-radius: 20px;
				border: 1px solid rgba(255, 255, 255, 0.05);
			}
			.spotlight-section.active {
				display: block;
				animation: fadeIn 0.3s ease;
			}
			@keyframes fadeIn {
				from { opacity: 0; transform: translateY(10px); }
				to { opacity: 1; transform: translateY(0); }
			}
			.spotlight-content h3 {
				color: var(--accent);
				margin-bottom: 1rem;
			}
			.spotlight-content a {
				display: inline-block;
				margin-top: 1rem;
				padding: 0.8rem 1.5rem;
				background: var(--accent);
				color: #000;
				text-decoration: none;
				border-radius: 30px;
				font-weight: 600;
				transition: transform 0.2s ease;
			}
			.spotlight-content a:hover {
				transform: scale(1.05);
			}

			@media (max-width: 768px) {
				#chart-container {
					height: 350px;
				}
				.news-preview-card {
					display: none !important; /* Always use spotlight on mobile */
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<section class="market-header">
				<h1>Market Insights</h1>
				<p>나스닥 시장 변동과 AI 리포트의 상관관계를 확인하세요.</p>
			</section>

			<div class="chart-container-wrapper">
				<div id="chart-container" data-posts={postsBase64}></div>
				<div id="news-preview" class="news-preview-card">
					<h4 id="preview-title"></h4>
					<p id="preview-desc"></p>
				</div>
			</div>

			<div id="spotlight" class="spotlight-section">
				<div class="spotlight-content">
					<p class="date" id="spotlight-date" style="color: #888; font-size: 0.9rem;"></p>
					<h3 id="spotlight-title"></h3>
					<p id="spotlight-desc"></p>
					<a id="spotlight-link" href="#">전체 리포트 읽기</a>
				</div>
			</div>
		</main>
		<Footer />

		<script is:inline>
			console.log('Market Insight Script Loaded');
			let chartInstance = null;
			let isInitializing = false;

			function checkAndInit() {
				if (typeof LightweightCharts === 'undefined') {
					console.log('Waiting for LightweightCharts library...');
					setTimeout(checkAndInit, 100);
					return;
				}
				if (!isInitializing) {
					initChart();
				}
			}

			async function initChart() {
				const container = document.getElementById('chart-container');
				if (!container || isInitializing) return;
				
				isInitializing = true;
				try {
					const postsData = container.getAttribute('data-posts');
					// UTF-8 safe Base64 decode
					const posts = JSON.parse(decodeURIComponent(escape(atob(postsData))));
					console.log('Posts data parsed (Base64 UTF-8):', posts.length, posts);
					
					if (chartInstance) {
						chartInstance.remove();
						chartInstance = null;
					}
					container.innerHTML = '';
					
					console.log('Fetching NASDAQ data...');
					const response = await fetch('/data/nasdaq.json');
					if (!response.ok) throw new Error('Data fetch failed');
					const data = await response.json();
					console.log('Market data loaded:', data.length);

					const chart = LightweightCharts.createChart(container, {
						width: container.clientWidth,
						height: 600,
						layout: {
							background: { type: 'solid', color: 'transparent' },
							textColor: '#d1d4dc',
						},
						grid: {
							vertLines: { color: 'rgba(42, 46, 57, 0.3)' },
							horzLines: { color: 'rgba(42, 46, 57, 0.3)' },
						},
						rightPriceScale: { 
							borderColor: 'rgba(197, 203, 206, 0.8)', 
							autoScale: true,
							mode: 1, // Logarithmic
						},
						timeScale: { 
							borderColor: 'rgba(197, 203, 206, 0.8)', 
							timeVisible: true,
						},
					});
					chartInstance = chart;

					const candleSeries = chart.addCandlestickSeries({
						upColor: '#26a69a',
						downColor: '#ef5350',
						borderVisible: false,
						wickUpColor: '#26a69a',
						wickDownColor: '#ef5350',
					});
					window.candleSeries = candleSeries; // For debugging

					candleSeries.setData(data);

					console.log('Fetching Macro data...');
					const macroResponse = await fetch('/data/nasdaq_macro.json');
					const macroData = await macroResponse.json();
					console.log('Macro data loaded:', macroData.length);

					const trendSeries = chart.addLineSeries({
						color: '#ff9800',
						lineWidth: 2,
						lineStyle: 2, // Dashed
						title: 'Robust Trend',
						priceLineVisible: false,
						lastValueVisible: false,
					});

					const upperSeries = chart.addLineSeries({
						color: 'rgba(239, 83, 80, 0.5)',
						lineWidth: 1,
						lineStyle: 3, // Dotted
						title: 'Upper Bound (Z=2)',
						priceLineVisible: false,
						lastValueVisible: false,
					});

					const lowerSeries = chart.addLineSeries({
						color: 'rgba(38, 166, 154, 0.5)',
						lineWidth: 1,
						lineStyle: 3, // Dotted
						title: 'Lower Bound (Z=-2)',
						priceLineVisible: false,
						lastValueVisible: false,
					});

					const trendData = macroData.map(d => ({ time: d.time, value: d.trend }));
					const upperData = macroData.map(d => ({ time: d.time, value: d.upper }));
					const lowerData = macroData.map(d => ({ time: d.time, value: d.lower }));
					
					trendSeries.setData(trendData);
					upperSeries.setData(upperData);
					lowerSeries.setData(lowerData);

					// EMA Series
					const ema5Series = chart.addLineSeries({ color: '#ffffff', lineWidth: 1, title: 'EMA 5', priceLineVisible: false, lastValueVisible: false });
					const ema20Series = chart.addLineSeries({ color: '#ffeb3b', lineWidth: 1, title: 'EMA 20', priceLineVisible: false, lastValueVisible: false });
					const ema60Series = chart.addLineSeries({ color: '#4caf50', lineWidth: 1, title: 'EMA 60', priceLineVisible: false, lastValueVisible: false });
					const ema120Series = chart.addLineSeries({ color: '#2196f3', lineWidth: 1, title: 'EMA 120', priceLineVisible: false, lastValueVisible: false });
					const ema200Series = chart.addLineSeries({ color: '#9c27b0', lineWidth: 1, title: 'EMA 200', priceLineVisible: false, lastValueVisible: false });

					ema5Series.setData(data.map(d => ({ time: d.time, value: d.ema5 })));
					ema20Series.setData(data.map(d => ({ time: d.time, value: d.ema20 })));
					ema60Series.setData(data.map(d => ({ time: d.time, value: d.ema60 })));
					ema120Series.setData(data.map(d => ({ time: d.time, value: d.ema120 })));
					ema200Series.setData(data.map(d => ({ time: d.time, value: d.ema200 })));
					
					// DEBUG: Log types and values
					if (data.length > 0 && posts.length > 0) {
						console.log('DEBUG MATCHING:');
						console.log('Candle[last].time:', data[data.length-1].time, typeof data[data.length-1].time);
						console.log('Post[0].pubDate:', posts[0].pubDate, typeof posts[0].pubDate);
					}

					// Markers with compatible v3.8.0 shapes
					if (posts && posts.length > 0) {
						// Helper to convert YYYY-MM-DD to {year, month, day}
						const toBusinessDay = (dateStr) => {
							const [y, m, d] = dateStr.split('-').map(Number);
							return { year: y, month: m, day: d };
						};

						// Helper to convert {year, month, day} to YYYY-MM-DD
						const toString = (bd) => `${bd.year}-${String(bd.month).padStart(2, '0')}-${String(bd.day).padStart(2, '0')}`;

						const candleTimesStr = data.map(d => typeof d.time === 'string' ? d.time : toString(d.time));
						
						const markers = posts.map(post => {
							let bestTimeStr = post.pubDate;
							if (!candleTimesStr.includes(bestTimeStr)) {
								const pastTimes = candleTimesStr.filter(t => t <= bestTimeStr);
								bestTimeStr = pastTimes.length > 0 ? pastTimes[pastTimes.length - 1] : null;
							}
							
							if (bestTimeStr) {
								return {
									time: toBusinessDay(bestTimeStr),
									position: 'aboveBar',
									color: '#e91e63', 
									shape: 'pin',
									size: 1.5,
									text: 'REPORT',
								};
							}
							return null;
						}).filter(m => m !== null);
						
						console.log('Setting markers:', markers.length, markers);
						candleSeries.setMarkers(markers);
					}

					// Zoom to last 2 weeks
					if (data.length > 10) {
						const lastIndex = data.length - 1;
						const startIndex = Math.max(0, lastIndex - 12);
						chart.timeScale().setVisibleRange({
							from: data[startIndex].time,
							to: data[lastIndex].time,
						});
					}

					window.addEventListener('resize', () => {
						if (chartInstance) chartInstance.applyOptions({ width: container.clientWidth });
					});
					
					setupInteractions(chart, candleSeries, posts);
					console.log('Chart initialization complete');
				} catch (err) {
					console.error('Chart Error:', err);
					container.innerHTML = `<p style="color: #ef5350; padding: 20px;">차트를 불러오는 중 오류가 발생했습니다: ${err.message}</p>`;
				} finally {
					isInitializing = false;
				}
			}

			function setupInteractions(chart, candleSeries, posts) {
				const newsPreview = document.getElementById('news-preview');
				const spotlight = document.getElementById('spotlight');
				const container = document.getElementById('chart-container');

				chart.subscribeCrosshairMove(param => {
					if (!param.point || !param.time) {
						newsPreview.style.display = 'none';
						return;
					}

					const dateStr = typeof param.time === 'string' ? param.time : 
									`${param.time.year}-${String(param.time.month).padStart(2, '0')}-${String(param.time.day).padStart(2, '0')}`;
					
					const post = posts.find(p => p.pubDate === dateStr);
					if (post) {
						newsPreview.style.display = 'block';
						
						// Smart positioning to stay within container
						const containerRect = container.getBoundingClientRect();
						let left = param.point.x + 20;
						let top = param.point.y + 20;
						
						if (left + 320 > containerRect.width) left = param.point.x - 340;
						if (top + 150 > containerRect.height) top = param.point.y - 170;

						newsPreview.style.left = left + 'px';
						newsPreview.style.top = top + 'px';
						document.getElementById('preview-title').innerText = post.title;
						document.getElementById('preview-desc').innerText = post.description || '';
					} else {
						newsPreview.style.display = 'none';
					}
				});

				chart.subscribeClick(param => {
					if (!param.time) return;
					const dateStr = typeof param.time === 'string' ? param.time : 
									`${param.time.year}-${String(param.time.month).padStart(2, '0')}-${String(param.time.day).padStart(2, '0')}`;
					const post = posts.find(p => p.pubDate === dateStr);
					if (post) {
						spotlight.classList.add('active');
						document.getElementById('spotlight-date').innerText = post.pubDate;
						document.getElementById('spotlight-title').innerText = post.title;
						document.getElementById('spotlight-desc').innerText = post.description || '';
						document.getElementById('spotlight-link').href = `/blog/${post.id}/`;
						spotlight.scrollIntoView({ behavior: 'smooth' });
					}
				});
			}

			checkAndInit();
		</script>
	</body>
</html>
