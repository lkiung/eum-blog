---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
import { getCollection } from 'astro:content';
import FormattedDate from '../components/FormattedDate.astro';

const allPosts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

import MacroGauge from '../components/MacroGauge.astro';
import currentStance from '../../public/data/current_macro_stance.json';


const categories = [
	{ id: 'Daily Report', label: 'Daily Report', shortLabel: 'Daily', icon: '📋' },
	{ id: 'Macro', label: 'Macro Analysis', shortLabel: 'Macro', icon: '🌐' },
	{ id: 'Individual Analysis', label: 'Company Analysis', shortLabel: 'Company', icon: '🏢' },
];

// Initial state for the first render (all posts are Daily Report for now)
const initialCategory = 'Daily Report';
---

<!doctype html>
<html lang="ko">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<style>
			main {
				width: 900px;
				max-width: calc(100% - 2em);
				margin: auto;
				padding: 4em 1em;
			}
			.hero {
				text-align: center;
				padding: 5rem 0;
				margin-bottom: 2rem;
				animation: fadeInUp 0.8s ease;
			}
			@keyframes fadeInUp {
				from { opacity: 0; transform: translateY(20px); }
				to { opacity: 1; transform: translateY(0); }
			}
			.quote-container {
				margin: 0 auto;
				display: flex;
				flex-direction: column;
				align-items: center;
				gap: 2rem;
				position: relative;
				padding: 4rem 3rem;
				background: linear-gradient(145deg, rgba(255,255,255,0.03) 0%, rgba(255,255,255,0.01) 100%);
				border-radius: 32px;
				border: 1px solid rgba(255, 255, 255, 0.05);
				max-width: 850px;
				box-shadow: 0 30px 60px rgba(0,0,0,0.3);
			}
			.quote-mark {
				position: absolute;
				font-size: 5rem;
				font-family: 'Times New Roman', serif;
				color: var(--accent);
				opacity: 0.1;
				line-height: 1;
				user-select: none;
			}
			.quote-mark.open {
				top: 1.5rem;
				left: 2rem;
			}
			.quote-mark.close {
				bottom: 1.5rem;
				right: 2rem;
				transform: rotate(180deg);
			}
			.tagline {
				font-size: 2rem;
				font-weight: 700;
				line-height: 1.4;
				color: #fff;
				margin: 0;
				word-break: keep-all;
				text-align: center;
				position: relative;
				letter-spacing: -0.02em;
				z-index: 1;
				text-shadow: 0 2px 10px rgba(0,0,0,0.3);
			}
			.author {
				font-size: 1rem;
				color: var(--text-secondary);
				font-weight: 700;
				letter-spacing: 0.3em;
				text-transform: uppercase;
				margin: 0;
				display: flex;
				align-items: center;
				gap: 1.5rem;
				opacity: 0.8;
			}
			.author::before, .author::after {
				content: '';
				width: 40px;
				height: 1px;
				background: linear-gradient(to right, transparent, var(--accent), transparent);
				opacity: 0.5;
			}
			
			/* Category Tabs */
			.category-tabs {
				display: flex;
				justify-content: center;
				gap: 1rem;
				margin-bottom: 3rem;
				border-bottom: 1px solid rgba(255,255,255,0.1);
				padding-bottom: 1rem;
			}
			.tab-button {
				background: none;
				border: none;
				color: var(--text-secondary);
				font-size: 1.1rem;
				font-weight: 600;
				padding: 0.8rem 1.5rem;
				cursor: pointer;
				transition: all 0.3s ease;
				border-radius: 8px;
				display: flex;
				align-items: center;
				gap: 0.5rem;
			}
			.tab-button:hover {
				background: rgba(255,255,255,0.05);
				color: #fff;
			}
			.tab-button.active {
				color: var(--accent);
				background: rgba(var(--accent-rgb), 0.1);
			}

			.reports-grid {
				display: none;
				animation: fadeIn 0.5s ease;
			}
			.reports-grid.active {
				display: block;
			}
			@keyframes fadeIn {
				from { opacity: 0; }
				to { opacity: 1; }
			}

			ul {
				list-style-type: none;
				padding: 0;
				margin: 0;
			}
			.report-card {
				display: flex;
				justify-content: space-between;
				align-items: center;
				padding: 2rem 0;
				border-bottom: 1px solid rgba(255,255,255,0.05);
				text-decoration: none;
				transition: all 0.3s ease;
			}
			.report-card:hover {
				padding-left: 1rem;
				background: rgba(255,255,255,0.02);
			}
			.report-card:hover .title {
				color: var(--accent);
			}
			.report-card:hover .card-arrow {
				transform: translateX(10px);
				color: var(--accent);
			}
			.card-content {
				flex: 1;
			}
			.title {
				margin: 0.5rem 0;
				font-size: 1.5rem;
				color: #fff;
			}
			.date {
				margin: 0;
				color: #666;
				font-size: 0.9rem;
				font-family: monospace;
			}
			.description {
				margin: 0;
				color: #aaa;
				font-size: 1rem;
				display: -webkit-box;
				-webkit-line-clamp: 2;
				-webkit-box-orient: vertical;
				overflow: hidden;
			}
			.card-arrow {
				font-size: 1.5rem;
				color: #333;
				transition: all 0.3s ease;
				margin-left: 2rem;
			}

			.empty-state {
				text-align: center;
				padding: 4rem 2rem;
				color: var(--text-secondary);
				background: rgba(255,255,255,0.02);
				border-radius: 12px;
				border: 1px dashed rgba(255,255,255,0.1);
			}
			.tab-label-short {
				display: none;
			}

			@media (max-width: 720px) {
				main {
					padding: 1.5em 1em;
				}
				.hero {
					padding: 2rem 0;
				}
				.quote-container {
					padding: 2rem 1.2rem;
					border-radius: 20px;
					gap: 1.5rem;
				}
				.tagline {
					font-size: 1.3rem;
					line-height: 1.5;
				}
				.quote-mark {
					font-size: 3rem;
				}
				.quote-mark.open {
					top: 0.8rem;
					left: 1rem;
				}
				.quote-mark.close {
					bottom: 0.8rem;
					right: 1rem;
				}
				.category-tabs {
					gap: 0.5rem;
				}
				.tab-button {
					font-size: 0.85rem;
					padding: 0.6rem 0.9rem;
					flex: 1;
					justify-content: center;
					gap: 0.3rem;
				}
				.icon {
					display: none;
				}
				.tab-label-full {
					display: none;
				}
				.tab-label-short {
					display: inline;
				}
				.report-card {
					padding: 1.2rem 0;
				}
				.report-card:hover {
					padding-left: 0;
				}
				.report-card:active {
					background: rgba(255,255,255,0.04);
				}
				.title {
					font-size: 1.05rem;
				}
				.description {
					font-size: 0.88rem;
				}
				.card-arrow {
					margin-left: 0.8rem;
					font-size: 1.1rem;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<section class="hero">
				<div class="quote-container">
					<span class="quote-mark open">“</span>
					<p class="tagline">직관적인 투자자가 AI를 보조 도구로 활용한다면<br/>그 조합이 세계 최고의 투자자일 것이다.</p>
					<p class="author">Stanley Druckenmiller</p>
					<span class="quote-mark close">“</span>
				</div>
			</section>

			<nav class="category-tabs" aria-label="Blog categories">
				{categories.map((cat) => (
					<button
						class={`tab-button ${cat.id === initialCategory ? 'active' : ''}`}
						data-category={cat.id}
					>
						<span class="icon">{cat.icon}</span>
						<span class="tab-label-full">{cat.label}</span>
						<span class="tab-label-short">{cat.shortLabel}</span>
					</button>
				))}
			</nav>

			<section class="content-area">
				{categories.map((cat) => (
					<div 
						id={`category-${cat.id}`} 
						class={`reports-grid ${cat.id === initialCategory ? 'active' : ''}`}
					>
						{cat.id === 'Macro' && <MacroGauge stance={currentStance} />}
						{allPosts.filter(p => p.data.category === cat.id).length > 0 ? (
							<ul>
								{allPosts.filter(p => p.data.category === cat.id).map((post) => (
									<li>
										<a href={`/blog/${post.id}/`} class="report-card">
											<div class="card-content">
												<p class="date">
													<FormattedDate date={post.data.pubDate} />
												</p>
												<h3 class="title">{post.data.title}</h3>
												{post.data.description && <p class="description">{post.data.description}</p>}
											</div>
											<div class="card-arrow">→</div>
										</a>
									</li>
								))}
							</ul>
						) : (
							<div class="empty-state">
								<p>준비 중인 카테고리입니다. 곧 새로운 인사이트로 찾아뵙겠습니다.</p>
							</div>
						)}
					</div>
				))}
			</section>
		</main>

		<script>
			const tabButtons = document.querySelectorAll('.tab-button');
			const grids = document.querySelectorAll('.reports-grid');

			tabButtons.forEach(button => {
				button.addEventListener('click', () => {
					const category = button.getAttribute('data-category');

					// Update buttons
					tabButtons.forEach(btn => btn.classList.remove('active'));
					button.classList.add('active');

					// Update grids
					grids.forEach(grid => {
						grid.classList.remove('active');
						if (grid.id === `category-${category}`) {
							grid.classList.add('active');
						}
					});
				});
			});
		</script>
		<Footer />
	</body>
</html>
