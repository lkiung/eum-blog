---
import { SITE_TITLE } from '../consts';
import HeaderLink from './HeaderLink.astro';
---

<header class="glass-nav">
	<nav>
		<h2><a href="/">{SITE_TITLE}</a></h2>
		<div class="internal-links">
			<HeaderLink href="/">Home</HeaderLink>
			<HeaderLink href="/market">Market</HeaderLink>
			<HeaderLink href="/about">About</HeaderLink>
		</div>
	</nav>
</header>
<style>
	header {
		position: sticky;
		top: 0;
		z-index: 100;
		margin: 0;
		padding: 0 2em;
		background: rgba(24, 23, 21, 0.88);
		backdrop-filter: blur(12px);
		-webkit-backdrop-filter: blur(12px);
		border-bottom: 1px solid var(--border-accent);
	}
	h2 {
		margin: 0;
		font-size: 1.1rem;
		font-weight: 700;
		letter-spacing: -0.02em;
		white-space: nowrap;
	}
	h2 a {
		color: #fff;
		text-decoration: none;
	}
	nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
		max-width: 1200px;
		margin: 0 auto;
		height: 52px;
	}
	nav a {
		padding: 0.6em 1em;
		color: var(--text-secondary);
		text-decoration: none;
		font-size: 0.9rem;
		font-weight: 500;
		transition: color 0.2s ease;
		white-space: nowrap;
	}
	nav a:hover,
	nav a.active {
		color: var(--accent);
	}
	.internal-links {
		display: flex;
		align-items: center;
	}

	@media (max-width: 600px) {
		header {
			padding: 0 1rem;
		}
		nav {
			height: 46px;
		}
		h2 {
			font-size: 0.95rem;
		}
		nav a {
			padding: 0.5em 0.6em;
			font-size: 0.82rem;
		}
	}
</style>
